# ============================================================
# SentinelTrade - variáveis de ambiente
# Copie para .env e preencha localmente. NUNCA versione o .env.
# Os campos de segredo ficam vazios de propósito.
# ============================================================

# Aplicação
APP_ENV=development
LOG_LEVEL=INFO

# Banco de dados (SQLite)
DATABASE_URL=sqlite:///./sentineltrade.db

# Segredos (gerar localmente; não deixar valores aqui)
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# Autenticação e MFA
MFA_ISSUER=SentinelTrade
MFA_CODE_TTL_SECONDS=300
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Limites de requisições
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_ORDERS_PER_MIN=30

# Regras de mercado
QUOTE_MAX_AGE_SECONDS=5
PRICE_BAND_PERCENT=10

# Integrações simuladas
BOLSA_SIMULADA_URL=
BOLSA_SIMULADA_API_KEY=
NOTIFICACAO_URL=
NOTIFICACAO_API_KEY=
INTEGRATION_TIMEOUT_MS=3000
INTEGRATION_MAX_RETRIES=3
