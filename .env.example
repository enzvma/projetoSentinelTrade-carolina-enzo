# ============================================================
# SentinelTrade - variáveis de ambiente
# Copie para .env e preencha localmente. NUNCA versione o .env.
# Os segredos ficam vazios de propósito; gere-os com:
#     sentineltrade gerar-segredos
# Sem eles a aplicação não inicia.
# ============================================================

# Aplicação (development, test ou production)
APP_ENV=development
LOG_LEVEL=INFO

# Banco de dados (SQLite)
DATABASE_URL=sqlite:///./sentineltrade.db

# Segredos
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# Autenticação e MFA
MFA_ISSUER=SentinelTrade
MFA_CODE_TTL_SECONDS=300
ACCESS_TOKEN_MINUTES=15
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Limites de requisições (por minuto)
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_ORDERS_PER_MIN=30

# Integrações simuladas (corretora)
INTEGRATION_TIMEOUT_MS=3000
INTEGRATION_MAX_RETRIES=3

# BFF (interface web): endereço da API e proxies cujo X-Forwarded-For a API aceita
API_URL=http://127.0.0.1:8000
TRUSTED_PROXIES=["127.0.0.1"]

# Regras de mercado (horário, faixa de preço, validade da cotação e taxa)
# ficam na tabela "parametros" do banco e são alteradas pelo Administrador.
